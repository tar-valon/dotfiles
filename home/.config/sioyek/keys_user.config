# --- Dark mode toggle ---
toggle_dark_mode                i

# --- Smooth scroll movement (vim-style) ---
move_left                       h
move_right                      l
move_down_smooth                j
move_up_smooth                  k

# --- Shift+j / Shift+k: move a full screen up/down ---
screen_down                     J
screen_up                       K

# --- Presentation mode ---
toggle_presentation_mode        P

# --- Navigation ---
next_page                       J
previous_page                   K
toggle_fullscreen               f

# --- Zoom / fit ---
zoom_in                         +
zoom_out                        -
fit_to_page_width               \
fit_to_page_height              |

# --- Search ---
search                          /

# --- Quit ---
quit                            q
